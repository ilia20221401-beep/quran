[{"numberInSurah":1,"textArabic":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","textPersian":"بگو: پناه می برم به پروردگار مردم"},{"numberInSurah":2,"textArabic":"مَلِكِ ٱلنَّاسِ","textPersian":"[به] پادشاه مردم"},{"numberInSurah":3,"textArabic":"إِلَٰهِ ٱلنَّاسِ","textPersian":"[به] معبود مردم"},{"numberInSurah":4,"textArabic":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","textPersian":"از زیان وسوسه گر کمین گرفته و پنهان،"},{"numberInSurah":5,"textArabic":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","textPersian":"آنکه همواره در سینه های مردم وسوسه می کند"},{"numberInSurah":6,"textArabic":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","textPersian":"از جنّیان و آدمیان."}]