[{"numberInSurah":1,"textArabic":"ٱلْقَارِعَةُ","textPersian":"آن کوبنده"},{"numberInSurah":2,"textArabic":"مَا ٱلْقَارِعَةُ","textPersian":"چیست آن کوبنده؟"},{"numberInSurah":3,"textArabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","textPersian":"و تو چه می دانی آن کوبنده چیست؟"},{"numberInSurah":4,"textArabic":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","textPersian":"روزی که مردم [در سراسیمگی] چون پروانه های پراکنده اند"},{"numberInSurah":5,"textArabic":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","textPersian":"و کوه ها مانند پشم رنگین حلاجی شده گردد!"},{"numberInSurah":6,"textArabic":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","textPersian":"اما هرکس اعمال وزن شده اش سنگین و باارزش است؛"},{"numberInSurah":7,"textArabic":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","textPersian":"پس او در یک زندگی خوش و پسندیده ای است،"},{"numberInSurah":8,"textArabic":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","textPersian":"و اما هرکساعمال وزن شده اش سبک و بی ارزش است،"},{"numberInSurah":9,"textArabic":"فَأُمُّهُۥ هَاوِيَةٌۭ","textPersian":"پس جایگاه و پناهگاهش هاویه است،"},{"numberInSurah":10,"textArabic":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","textPersian":"و تو چه می دانی هاویه چیست؟"},{"numberInSurah":11,"textArabic":"نَارٌ حَامِيَةٌۢ","textPersian":"آتشی بسیار داغ و سوزاناست."}]