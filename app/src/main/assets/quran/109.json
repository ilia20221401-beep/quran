[{"numberInSurah":1,"textArabic":"قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","textPersian":"بگو: ای کافران!"},{"numberInSurah":2,"textArabic":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","textPersian":"آنچه را شما می پرستید، من نمی پرستم،"},{"numberInSurah":3,"textArabic":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","textPersian":"و نه شما آنچه را من می پرستم، می پرستید،"},{"numberInSurah":4,"textArabic":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","textPersian":"و نه من آنچه را شما پرستیده اید، می پرستم،"},{"numberInSurah":5,"textArabic":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","textPersian":"و نه شما آنچه را که من می پرستم، می پرستید."},{"numberInSurah":6,"textArabic":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","textPersian":"دین شما برای خودتان، و دین من برای خودم."}]